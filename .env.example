# `cp .env.example .env` してから値を書き換える
# `vercel env pull` は .env.local を上書きするので、手で書く値は .env に置く

# Discord（フォーラムチャンネルの Webhook URL）。本番とは別のテスト用チャンネルを使うとよい
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/xxx/yyy"

# GitHub Webhook の Secret（Webhook 設定の Secret と同じ値）
GITHUB_WEBHOOK_SECRET="your_github_webhook_secret_here"

# Supabase は `bunx vercel@latest env pull` で .env.local に入るので、ここには書かない。
# Vercel を使わない場合だけ、コメントを外して書く
# SUPABASE_URL="https://xxx.supabase.co"
# SUPABASE_SECRET_KEY="sb_secret_xxx"
