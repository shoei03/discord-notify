# アプリが読む環境変数の一覧。値はこのファイルに書かない。
# 本番は Vercel の環境変数、開発は 1Password Environment に入れて .env にマウントする（README 参照）

# Discord フォーラムチャンネルの Webhook URL。開発ではテスト用チャンネルのものを使う
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/xxx/yyy"

# GitHub Webhook の Secret。本番は GitHub の Webhook 設定と同じ値。
# 開発は GitHub から届かないので、本番とは別のランダムな値（例: openssl rand -hex 32）
GITHUB_WEBHOOK_SECRET="your_github_webhook_secret_here"

# Supabase。本番は Vercel の Supabase 連携が自動で登録する。
# 開発は本番と同じ値（Supabase ダッシュボード → Project Settings → API Keys の Secret keys）
SUPABASE_URL="https://xxx.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_xxx"
